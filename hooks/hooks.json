{
  "description": "claude-toolkit guardrail and productivity hooks. Per-capability enable/disable is controlled by `claude-toolkit manage`, stored in the toolkit's private config; these hooks always run and the runtime filters disabled capabilities.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-toolkit\" run --event=pre --timeout=10000", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit)$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-toolkit\" run --event=post --timeout=30000", "timeout": 30 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Bash)$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-toolkit\" run --event=failure --timeout=30000", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-toolkit\" run --event=session --timeout=15000", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-toolkit\" run --event=prompt --timeout=5000", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-toolkit\" run --event=stop --timeout=10000", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claude-toolkit\" run --event=session-end --timeout=5000", "timeout": 5 }
        ]
      }
    ]
  }
}
